# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Le modèle de variables est versionné : il ne contient aucune valeur, et sans
# lui une installation neuve ne sait pas quelles variables renseigner.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
# Les sessions sont liées à une origine : `.auth` sert localhost, et tout autre
# jeu de cookies (par exemple `.auth-prod` pour rejouer la suite contre le
# domaine public) reste hors du dépôt.
/tests/.auth*/
/test-results/
/playwright-report/
