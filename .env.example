# -----------------------------------------------------------------------------
# GereoTimes — modèle de variables d'environnement
# Copier vers .env.local puis renseigner les valeurs.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Chaîne PostgreSQL utilisée par npm run db:apply / db:check / db:verify.
# Sur un réseau sans IPv6, la connexion directe db.<ref>.supabase.co est
# injoignable : passer par le pooler, port 6543 (mode transaction).
#   postgresql://postgres.<ref>:<motdepasse>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# Notifications par email — facultatif. Sans ces valeurs, aucun email n'est
# expédié et les notifications restent internes à l'application.
RESEND_API_KEY=
EMAIL_FROM=

# Jeton partagé avec Vercel Cron : Vercel le joint à chaque appel de
# /api/cron/quotidien en « Authorization: Bearer <valeur> ». Sans lui, la route
# refuse tout appel (401). Générer par : node -e "console.log(require('crypto')
# .randomBytes(32).toString('hex'))"
CRON_SECRET=
